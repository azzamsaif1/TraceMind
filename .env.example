# ---------------------------------------------------------------------------
# Rusted Recall - environment template
# Copy to .env and fill in real values. NEVER commit a real .env file.
# All values below are placeholders and are safe to commit.
# ---------------------------------------------------------------------------

# Runtime environment: development | production
APP_ENV=development

# --- Backblaze B2 (S3-compatible API) ---------------------------------------
# Create an application key in the Backblaze console. Use a bucket-scoped key.
# S3 endpoint looks like: https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=your-b2-key-id-here
B2_APP_KEY=your-b2-application-key-here
B2_BUCKET_NAME=your-bucket-name-here
B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004

# --- GMI Cloud image provider (Inference Engine request queue) ---------------
# API key from https://console.gmicloud.ai. Seedream 5.0 Pro is reached via the
# request queue at {BASE_URL}/api/v1/ie/requestqueue/apikey/requests.
GMICLOUD_API_KEY=your-gmicloud-api-key-here
GMICLOUD_BASE_URL=https://console.gmicloud.ai
GMICLOUD_MODEL=seedream-5.0-pro

# --- Genblaze pipeline -------------------------------------------------------
# When true AND the pinned upstream SDK (genblaze-core, genblaze-gmicloud in
# requirements.txt) is installed, real repairs run through the official Genblaze
# runtime. When false (or SDK absent) the direct GMI request-queue adapter is
# used. Either way, output is never fabricated. See docs/OPERATIONS.md.
GENBLAZE_ENABLED=true

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://rusted:rusted@localhost:5432/rusted_recall

# --- Application -------------------------------------------------------------
# Comma-separated list of allowed CORS origins (no wildcard in production).
CORS_ALLOW_ORIGINS=http://localhost:8501,http://localhost:8000
# Public demo cost/quota controls
DEMO_MAX_ASSETS_PER_RECALL=25
DEMO_MAX_REPAIRS_PER_RECALL=3
DEMO_MAX_CONCURRENT_JOBS=2
